# Shugela → Supabase
# Copy this file to `.env.local` (git-ignored) and fill in the two values from
# Supabase → Project Settings → API.
#
#   cp .env.example .env.local        (macOS/Linux)
#   copy .env.example .env.local       (Windows)

# Project URL — Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# anon / "public" key — Supabase → Project Settings → API → Project API keys.
# This key is designed to ship in the browser: access is controlled by the Row
# Level Security policies in supabase/migrations/0001_init.sql.
#
# NEVER put the service_role key in this file or anywhere in the client bundle.
# It bypasses RLS and would expose every user's readings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=